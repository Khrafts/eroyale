# Testnet keys only. Copy to .env and fill in.
RPC_URL=                  # NOWNodes endpoint for the chain below
CHAIN=base-sepolia        # or ethereum-sepolia
CHAIN_SELECTOR=           # from Chainlink's directory for that chain; do not guess
FORWARDER_ADDRESS=        # MockForwarder (simulation) or KeystoneForwarder (deployed), from Chainlink's Forwarder Directory
PRIVATE_KEY_DEPLOYER=
PRIVATE_KEY_RELAYER=
TREASURY_ADDRESS=
TOKEN_ADDRESS=            # written after deploy
ESCROW_ADDRESS=           # written after deploy
SETTLE_MODE=simulated     # or deployed
PRICE_SOURCE_URL=         # Coinbase Exchange 1-minute candles; see workflow/src/prices.ts
ENGINE_PUBLIC_URL=        # public HTTPS address of the engine, reachable by the workflow
NEXT_PUBLIC_ENGINE_WS=    # ws(s)://.../ws
# Stickman Duel (optional): DeployDuel broadcaster key, owner override, opt-in relayer approve and deployment-file write
PRIVATE_KEY_DUEL_DEPLOYER=
ENGINE_OWNER_ADDRESS=
APPROVE_FROM_RELAYER=
WRITE_DEPLOYMENT=
DUEL_ESCROW_ADDRESS=
